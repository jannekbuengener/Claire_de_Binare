[Unit]
Description=CDB Hermes Runs API gateway for cdb-engineer (#4466)
Documentation=https://github.com/jannekbuengener/Claire_de_Binare/issues/4466
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/hermes/profiles/cdb-engineer/.DISABLED

[Service]
Type=simple
User=hermes-cdb-engineer
Group=hermes-cdb-engineer
Environment=HERMES_HOME=/var/lib/hermes/profiles/cdb-engineer
Environment=HERMES_PROFILE=cdb-engineer
# The official v0.19.1 gateway reads these non-secret API settings and the
# protected API_SERVER_KEY from the profile environment file. Missing values
# fail closed before the gateway can start.
Environment=API_SERVER_ENABLED=true
Environment=API_SERVER_HOST=127.0.0.1
EnvironmentFile=/etc/hermes/cdb-engineer.env
WorkingDirectory=/var/lib/hermes/profiles/cdb-engineer
ExecStartPre=/usr/bin/test -d /var/lib/hermes/profiles/cdb-engineer
ExecStartPre=/usr/bin/test -f /var/lib/hermes/profiles/cdb-engineer/config.yaml
ExecStartPre=/usr/bin/test -n "${API_SERVER_PORT}"
ExecStartPre=/usr/bin/test -n "${API_SERVER_KEY}"
ExecStart=/opt/hermes/bin/hermes gateway
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
CPUQuota=80%
MemoryMax=1536M
TasksMax=256
LimitNOFILE=8192
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/hermes/profiles/cdb-engineer /var/log/hermes/cdb-engineer
ReadOnlyPaths=/home/hermes/.local/share/uv /opt/hermes /var/lib/hermes/_installer_home
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-gateway-cdb-engineer

[Install]
WantedBy=multi-user.target
