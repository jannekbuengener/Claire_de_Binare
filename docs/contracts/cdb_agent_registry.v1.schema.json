{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claire-de-binare.local/contracts/cdb_agent_registry.v1.schema.json",
  "title": "CDB Agent Registry v1",
  "description": "Provider-neutral declarative agent registry desired state. Schema id: cdb.agent_registry.v1. Unknown fields are rejected. Registry entries may only reduce Execution Contract profile permissions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "profiles",
    "agents"
  ],
  "properties": {
    "schema_id": {
      "const": "cdb.agent_registry.v1"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_contracts",
        "providers",
        "environments",
        "skills",
        "mcp"
      ],
      "properties": {
        "execution_contracts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/execution_contract_profile"
          }
        },
        "providers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/provider_profile"
          }
        },
        "environments": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/environment_profile"
          }
        },
        "skills": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/skill_profile"
          }
        },
        "mcp": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/mcp_profile"
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/agent_entry"
      }
    }
  },
  "$defs": {
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,120}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,120}$"
    },
    "permission_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_repo",
        "write_code",
        "write_docs",
        "commit",
        "push",
        "open_pr",
        "update_pr",
        "comment_issue",
        "close_issue",
        "publish_cdb_local_ci",
        "merge",
        "runtime_mutation",
        "database_mutation",
        "mcp_live_mutation"
      ],
      "properties": {
        "read_repo": { "type": "boolean" },
        "write_code": { "type": "boolean" },
        "write_docs": { "type": "boolean" },
        "commit": { "type": "boolean" },
        "push": { "type": "boolean" },
        "open_pr": { "type": "boolean" },
        "update_pr": { "type": "boolean" },
        "comment_issue": { "type": "boolean" },
        "close_issue": { "type": "boolean" },
        "publish_cdb_local_ci": { "type": "boolean" },
        "merge": { "type": "boolean" },
        "runtime_mutation": { "type": "boolean" },
        "database_mutation": { "type": "boolean" },
        "mcp_live_mutation": { "type": "boolean" }
      }
    },
    "execution_contract_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "permissions"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "permissions": {
          "$ref": "#/$defs/permission_map"
        }
      }
    },
    "provider_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "description", "api_surface"],
      "properties": {
        "provider_id": {
          "type": "string",
          "enum": [
            "mock",
            "cursor",
            "cursor-sdk",
            "cursor-cli",
            "cursor-cloud-api",
            "jules-api",
            "local"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "api_surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "live_dispatch": {
          "type": "boolean",
          "default": false,
          "description": "When false (default), real provider execution remains fail-closed."
        },
        "capability_baseline_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "secret_references": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "ref"],
            "properties": {
              "class": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "ref": {
                "type": "string",
                "pattern": "^(env|secret):[A-Za-z0-9_./-]{1,200}$"
              }
            }
          }
        }
      }
    },
    "environment_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "runtime_class"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "runtime_class": {
          "type": "string",
          "enum": ["local_repo", "cloud_agent", "mock"]
        },
        "profile_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "allowed_provider_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mock",
              "cursor",
              "cursor-sdk",
              "cursor-cli",
              "cursor-cloud-api",
              "jules-api",
              "local"
            ]
          }
        },
        "provider_config_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260
        },
        "provider_config_digest_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": ["sha256"]
            },
            "require_match": {
              "type": "boolean"
            }
          }
        },
        "source_commit_binding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "boolean"
            },
            "match_mode": {
              "type": "string",
              "enum": ["exact", "prefix"]
            }
          }
        },
        "workspace_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["read_only", "write_scoped", "blocked"]
            },
            "runtime_mutation": {
              "type": "boolean"
            },
            "database_mutation": {
              "type": "boolean"
            },
            "mcp_live_mutation": {
              "type": "boolean"
            }
          }
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260
          }
        },
        "forbidden_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260
          }
        },
        "allowed_command_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required_toolchain": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version_rule"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "version_rule": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          }
        },
        "setup_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fallback_to_unknown_base_image": {
              "type": "string",
              "enum": ["forbidden"]
            },
            "setup_failed": {
              "type": "string",
              "enum": ["block"]
            },
            "setup_unknown": {
              "type": "string",
              "enum": ["block"]
            },
            "require_attested_base_identity": {
              "type": "boolean"
            }
          }
        },
        "network_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["deny_all", "allowlist"]
            },
            "allowed_classes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "allowed_domains": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253
              }
            },
            "egress_enforcement_required": {
              "type": "boolean"
            }
          }
        },
        "secret_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed_classes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "workload_secrets": {
              "type": "string",
              "enum": ["none", "class_refs_only"]
            },
            "inject_cursor_api_key": {
              "type": "boolean"
            }
          }
        },
        "resource_limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu_cores_max": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "memory_mb_max": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "disk_mb_max": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "max_processes": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "enforcement_required": {
              "type": "boolean"
            }
          }
        },
        "execution_limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "setup_timeout_seconds": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "run_timeout_seconds": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "cancel_confirmation_required": {
              "type": "boolean"
            }
          }
        },
        "cost_limit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_live_cost_usd": {
              "type": "number",
              "minimum": 0
            },
            "unknown_cost_blocks_live": {
              "type": "boolean"
            },
            "enforcement_required": {
              "type": "boolean"
            }
          }
        },
        "artifact_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed_roots": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 260
              }
            },
            "forbid_absolute_paths": {
              "type": "boolean"
            },
            "forbid_presigned_urls": {
              "type": "boolean"
            },
            "auto_execute": {
              "type": "boolean"
            }
          }
        },
        "checkpoint_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "may_mutate_profile": {
              "type": "boolean"
            },
            "may_mutate_digest": {
              "type": "boolean"
            },
            "may_mutate_source_commit": {
              "type": "boolean"
            },
            "may_mutate_permissions": {
              "type": "boolean"
            },
            "provider_snapshot_is_cdb_checkpoint": {
              "type": "boolean"
            }
          }
        },
        "required_attestations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "live_dispatch_allowed": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "skill_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "skill_ids"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "skill_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,120}$"
          }
        }
      }
    },
    "mcp_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "servers", "mutation_allowed"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "servers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,120}$"
          }
        },
        "mutation_allowed": {
          "type": "boolean"
        }
      }
    },
    "agent_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "version",
        "enabled",
        "description",
        "execution_contract_profile",
        "provider_profile",
        "environment_profile",
        "skills",
        "mcp_profiles",
        "subagents",
        "labels_or_routing_selectors"
      ],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/agent_id"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "execution_contract_profile": {
          "$ref": "#/$defs/profile_id"
        },
        "provider_profile": {
          "$ref": "#/$defs/profile_id"
        },
        "environment_profile": {
          "$ref": "#/$defs/profile_id"
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profile_id"
          }
        },
        "mcp_profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profile_id"
          }
        },
        "subagents": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,120}$"
          }
        },
        "labels_or_routing_selectors": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "boolean", "integer"]
          },
          "minProperties": 1
        },
        "depends_on": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/agent_id"
          }
        },
        "permission_overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read_repo": { "type": "boolean" },
            "write_code": { "type": "boolean" },
            "write_docs": { "type": "boolean" },
            "commit": { "type": "boolean" },
            "push": { "type": "boolean" },
            "open_pr": { "type": "boolean" },
            "update_pr": { "type": "boolean" },
            "comment_issue": { "type": "boolean" },
            "close_issue": { "type": "boolean" },
            "publish_cdb_local_ci": { "type": "boolean" },
            "merge": { "type": "boolean" },
            "runtime_mutation": { "type": "boolean" },
            "database_mutation": { "type": "boolean" },
            "mcp_live_mutation": { "type": "boolean" }
          }
        }
      }
    }
  }
}
