{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claire-de-binare/docs/contracts/cdb_hh_hl_campaign_design_authorization.v1.schema.json",
  "title": "CDB hh_hl Campaign Design-GO v1",
  "description": "Machine-readable Owner Design-GO ratifying the frozen hh_hl draft design (grid + dataset + manifest fingerprint) for #4374. Ratifies design only. Does not authorize campaign execution, paper, live, echtgeld, or promotion. Must be posted as a fenced/plain JSON block in a GitHub issue comment and verified live.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "status",
    "repository",
    "issue",
    "authorizing_github_login",
    "bound_main_sha",
    "manifest_path",
    "manifest_fingerprint",
    "strategy_set",
    "grid",
    "dataset",
    "does_not_authorize",
    "lr_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "cdb.hh_hl_campaign_design_go.v1",
        "cdb.hh_hl_campaign_design_go.v1.draft"
      ]
    },
    "status": {
      "const": "GO_HH_HL_CAMPAIGN_DESIGN"
    },
    "repository": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[^\\s/]+/[^\\s/]+$"
    },
    "issue": {
      "const": 4374
    },
    "github_comment_id": {
      "type": "integer",
      "minimum": 1
    },
    "authorizing_github_login": {
      "const": "jannekbuengener"
    },
    "bound_main_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest_path": {
      "const": "config/arvp/hh_hl_campaign_4374_draft_v1.json"
    },
    "manifest_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "strategy_set": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "const": "hh_hl_continuation_v1" }
    },
    "grid": {
      "type": "object",
      "required": ["grid_provider_id", "variant_count", "slots"],
      "properties": {
        "grid_provider_id": { "const": "hh_hl_baseline_only_grid_v1" },
        "variant_count": { "const": 1 },
        "slots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "const": "hh_hl_baseline_001" }
        }
      }
    },
    "dataset": {
      "type": "object",
      "required": ["selection_sha256", "content_fingerprint_digest"],
      "properties": {
        "selection_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "content_fingerprint_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "does_not_authorize": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "lr_status": { "const": "NO-GO" },
    "notes": { "type": "string" }
  }
}
