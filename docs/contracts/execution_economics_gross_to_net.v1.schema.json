{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claire-de-binare/docs/contracts/execution_economics_gross_to_net.v1.schema.json",
  "title": "Execution Economics Gross-to-Net v1",
  "description": "Versioned research contract for reconciling gross PnL through fee, spread, slippage, fill, reject, latency and funding components to net PnL. Synthetic assumptions are explicit. Does not authorize live trading or prove venue realism.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "formula",
    "gross_pnl",
    "components",
    "net_pnl",
    "reconciled",
    "residual",
    "assumptions_snapshot",
    "limitations"
  ],
  "properties": {
    "contract_version": {
      "const": "execution_economics_gross_to_net.v1"
    },
    "formula": {
      "type": "string",
      "minLength": 1
    },
    "gross_pnl": {
      "type": "string",
      "description": "Reference/mid quote PnL on filled size; must not embed costs that are also subtracted as components."
    },
    "fill_price_embedded_gross": {
      "type": ["string", "null"],
      "description": "Legacy fill-price gross that already embeds slippage; informational only."
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maker_fee_cost",
        "taker_fee_cost",
        "total_fee_cost",
        "spread_cost",
        "slippage_cost",
        "partial_fill_impact",
        "reject_impact",
        "latency_or_delay_impact",
        "funding_cost_when_active"
      ],
      "properties": {
        "maker_fee_cost": { "$ref": "#/$defs/cost_component" },
        "taker_fee_cost": { "$ref": "#/$defs/cost_component" },
        "total_fee_cost": { "$ref": "#/$defs/cost_component" },
        "spread_cost": { "$ref": "#/$defs/cost_component" },
        "slippage_cost": { "$ref": "#/$defs/cost_component" },
        "partial_fill_impact": { "$ref": "#/$defs/cost_component" },
        "reject_impact": { "$ref": "#/$defs/cost_component" },
        "latency_or_delay_impact": { "$ref": "#/$defs/cost_component" },
        "funding_cost_when_active": { "$ref": "#/$defs/cost_component" }
      }
    },
    "net_pnl": {
      "type": "string"
    },
    "reconciled": {
      "type": "boolean"
    },
    "residual": {
      "type": "string"
    },
    "assumptions_snapshot": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "cost_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "amount", "status", "unit"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "amount": {
          "type": ["string", "null"],
          "description": "Unsigned quote cost when status is active/zero; null when not_applicable or inactive_not_wired."
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "zero",
            "not_applicable",
            "inactive_not_wired",
            "embedded_in_fill_price"
          ]
        },
        "unit": {
          "type": "string",
          "enum": ["quote_currency", "base_quantity", "rate", "bps", "bars", "milliseconds"]
        },
        "notes": { "type": "string" }
      }
    }
  }
}
