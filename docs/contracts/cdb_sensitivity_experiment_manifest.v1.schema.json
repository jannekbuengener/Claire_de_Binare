{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claire-de-binare/docs/contracts/cdb_sensitivity_experiment_manifest.v1.schema.json",
  "title": "CDB Replay-only Sensitivity Experiment Manifest v1",
  "description": "Versioned, deterministically fingerprintable experiment manifest for a future replay-only sensitivity campaign (#4153). Does not authorize campaign execution, Stage-A survivors, paper, live, or echtgeld.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "issue_ref",
    "parent_issue_ref",
    "source_commit",
    "baseline",
    "parameter_families",
    "design",
    "development_windows",
    "dataset_identity",
    "effective_config_snapshot_fingerprint",
    "parameter_control",
    "execution_economics_contract_version",
    "frozen_boundaries",
    "seed_rules",
    "allowed_result_fields",
    "holdout_denylist",
    "explicit_bans",
    "lr_status",
    "executable"
  ],
  "properties": {
    "schema_version": {
      "const": "cdb.sensitivity_experiment_manifest.v1"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "issue_ref": {
      "type": "string",
      "const": "#4153"
    },
    "parent_issue_ref": {
      "type": "string",
      "const": "#4147"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy_id", "scenario_id", "label"],
      "properties": {
        "strategy_id": { "type": "string", "minLength": 1 },
        "scenario_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "parameter_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family_id",
          "parameter_ids",
          "value_range",
          "step",
          "change_authority"
        ],
        "properties": {
          "family_id": { "type": "string", "minLength": 1 },
          "parameter_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^CDB-[0-9]{3,}$" }
          },
          "value_range": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max"],
            "properties": {
              "min": { "type": ["number", "string"] },
              "max": { "type": ["number", "string"] },
              "unit": { "type": "string" }
            }
          },
          "step": { "type": ["number", "string"] },
          "change_authority": {
            "type": "string",
            "enum": [
              "RESEARCH_ALLOWED",
              "CONDITIONAL_AFTER_EVIDENCE"
            ]
          },
          "notes": { "type": "string" }
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["one_factor_at_a_time", "interaction_groups"],
      "properties": {
        "one_factor_at_a_time": { "type": "boolean", "const": true },
        "interaction_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["group_id", "family_ids"],
            "properties": {
              "group_id": { "type": "string", "minLength": 1 },
              "family_ids": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "development_windows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_count",
        "window_ids",
        "selection_sha256",
        "purpose"
      ],
      "properties": {
        "window_count": { "type": "integer", "const": 39 },
        "window_ids": {
          "type": "array",
          "minItems": 39,
          "maxItems": 39,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^binance_1m_month_[0-9]{4}_[0-9]{2}$"
          }
        },
        "selection_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "purpose": { "const": "development" },
        "window_bank_identity": { "type": "string", "minLength": 1 }
      }
    },
    "dataset_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_fingerprint",
        "content_fingerprint",
        "identity_schema_version"
      ],
      "properties": {
        "request_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "content_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "identity_schema_version": {
          "const": "cdb.dataset_content_identity.v1"
        },
        "dataset_ref": { "type": "string", "minLength": 1 }
      }
    },
    "effective_config_snapshot_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parameter_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_schema_version", "register_fingerprint"],
      "properties": {
        "policy_schema_version": {
          "const": "cdb.parameter_control_policy.register.v1"
        },
        "register_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "execution_economics_contract_version": {
      "const": "execution_economics_gross_to_net.v1"
    },
    "frozen_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_a_gate_contract_sha256",
        "stage_b_confirmation_contract_sha256",
        "stage_a_b_oos_stress_gates",
        "risk_and_live_boundaries"
      ],
      "properties": {
        "stage_a_gate_contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stage_b_confirmation_contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stage_a_b_oos_stress_gates": { "const": "frozen" },
        "risk_and_live_boundaries": { "const": "frozen" }
      }
    },
    "seed_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deterministic", "seed_namespace"],
      "properties": {
        "deterministic": { "type": "boolean", "const": true },
        "seed_namespace": { "type": "string", "minLength": 1 },
        "seed_formula": { "type": "string" }
      }
    },
    "allowed_result_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "gate_reason",
          "regime_distribution",
          "trade_count",
          "turnover",
          "fees",
          "spread",
          "slippage",
          "gross_pnl",
          "net_pnl",
          "profit_factor",
          "expectancy",
          "drawdown",
          "main_effect",
          "interaction_effect",
          "overfitting_risk_flag"
        ]
      }
    },
    "holdout_denylist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["excluded_purposes", "excluded_overlap_classes"],
      "properties": {
        "excluded_purposes": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["validation", "out_of_sample", "stress"]
          }
        },
        "excluded_overlap_classes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["quarterly", "yearly"]
          }
        }
      }
    },
    "explicit_bans": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotion",
        "paper",
        "live",
        "echtgeld",
        "campaign_execution"
      ],
      "properties": {
        "promotion": { "const": true },
        "paper": { "const": true },
        "live": { "const": true },
        "echtgeld": { "const": true },
        "campaign_execution": { "const": true }
      }
    },
    "lr_status": { "const": "NO-GO" },
    "executable": {
      "const": false,
      "description": "Synthetic/readiness manifests must not be executable in this slice."
    },
    "manifest_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Optional embedded fingerprint; excluded from hash input."
    }
  }
}
