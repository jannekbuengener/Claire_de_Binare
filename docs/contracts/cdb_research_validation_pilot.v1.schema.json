        },
        "purpose": { "type": "string", "minLength": 1 },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "expected_artifact_refs": {
          "type": "array",
          "minItems": 8,
          "items": {
            "$ref": "#/definitions/ExpectedArtifact"
          }
        },
        "time_causality": { "$ref": "#/definitions/TimeCausality" },
        "as_of_rule": {
          "const": "No source or market datum with as_of after decision_time may be used."
        },
        "source_bindings": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/definitions/SourceBinding" }
        },
        "dataset_binding_policy": {
          "$ref": "#/definitions/DatasetBindingPolicy"
        },
        "economics_components": {
          "$ref": "#/definitions/EconomicsComponents"
        },
        "token_terminal_partial_success_policy": {
          "type": "string",
          "minLength": 1
        },
        "no_invented_numeric_results": { "const": true }
      }
    }
  }
}
