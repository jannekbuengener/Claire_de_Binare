        "pre_execution_cell_status": {
          "type": "string",
          "enum": ["PLANNED", "NOT_RUN"]
        },
        "no_subjective_ranking": { "const": true },
        "no_ranking_without_comparable_evidence": { "const": true },
        "tickersage_may_visualize_only": { "const": true }
      }
    },
