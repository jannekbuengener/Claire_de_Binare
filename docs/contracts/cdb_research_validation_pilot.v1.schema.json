        "decision_authority": { "const": false },
        "may_mutate_metrics": { "const": false },
        "may_write_lifecycle_transitions": { "const": false },
        "official_api_contract_present": { "const": false },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
