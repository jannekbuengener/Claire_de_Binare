        "hermes_validation_authority": { "const": false },
        "tickersage_validation_authority": { "const": false },
        "tickersage_decision_authority": { "const": false },
        "automatic_strategy_promotion": { "const": false },
        "paper_candidate_is_live_go": { "const": false },
        "paper_go": { "const": false },
        "live_go": { "const": false },
