      "properties": {
        "fees": { "type": "string", "minLength": 1 },
        "spread": { "type": "string", "minLength": 1 },
        "slippage": { "type": "string", "minLength": 1 },
        "fill_assumptions": { "type": "string", "minLength": 1 },
        "reject_assumptions": { "type": "string", "minLength": 1 },
        "latency_or_delay": { "type": "string", "minLength": 1 },
