{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cdb:schema:parameter-control-policy:compact:v1",
  "title": "Claire de Binare Compact Parameter Control Policy",
  "type": "object",
  "required": [
    "schema_version",
    "document_id",
    "status",
    "source",
    "default_policy",
    "context_codes",
    "rule_fields",
    "classes",
    "decisions",
    "names",
    "paths",
    "evidence",
    "rules",
    "global_invariants",
    "workflow_gates"
  ],
  "properties": {
    "schema_version": {
      "const": "cdb.parameter_control_policy.compact.v1"
    },
    "document_id": {
      "const": "CDB-PARAMETER-CONTROL-POLICY"
    },
    "status": {
      "enum": [
        "draft",
        "candidate",
        "canonical",
        "superseded"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "repository",
        "branch",
        "commit",
        "analysis_artifact",
        "meta_issue"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "analysis_artifact": {
          "type": "string"
        },
        "meta_issue": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "default_policy": {
      "type": "object",
      "required": [
        "unknown_parameter",
        "missing_evidence",
        "live_context",
        "principle",
        "stage_a_b_oos_stress_gates",
        "risk_and_live_boundaries"
      ],
      "properties": {
        "unknown_parameter": {
          "const": "deny"
        },
        "missing_evidence": {
          "const": "deny"
        },
        "live_context": {
          "const": "deny"
        },
        "principle": {
          "type": "string"
        },
        "stage_a_b_oos_stress_gates": {
          "const": "frozen"
        },
        "risk_and_live_boundaries": {
          "const": "frozen"
        }
      },
      "additionalProperties": false
    },
    "context_codes": {
      "const": {
        "r": "replay",
        "p": "paper",
        "u": "runtime",
        "l": "live",
        "d": "docs",
        "t": "tests"
      }
    },
    "rule_fields": {
      "const": [
        "id",
        "name_ref",
        "class_ref",
        "decision_ref",
        "may_change",
        "allowed_context_codes",
        "forbidden_context_codes",
        "blocked_by_issues",
        "path_refs",
        "evidence_refs"
      ]
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "CONDITIONAL_AFTER_EVIDENCE",
          "ALLOW_REPLAY_RESEARCH",
          "FROZEN_UNTIL_CONTRACT",
          "CORRECTNESS_FIX_ONLY",
          "NO_EFFECT_OR_DEAD",
          "FORBIDDEN_OPTIMIZATION",
          "ALLOW_PAPER_OPERATION",
          "ALLOW_RUNTIME_OPERATION",
          "NON_TUNABLE_INVARIANT"
        ]
      }
    },
    "names": {
      "type": "array",
      "minItems": 56,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 56,
      "maxItems": 56,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "pattern": "^CDB-[0-9]{3}$"
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "enum": [
              0,
              1
            ]
          },
          {
            "type": "string",
            "pattern": "^[rpuldt]*$"
          },
          {
            "type": "string",
            "pattern": "^[rpuldt]*$"
          },
          {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "minItems": 10,
        "maxItems": 10
      }
    },
    "global_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "workflow_gates": {
      "type": "object",
      "required": [
        "before_any_change",
        "before_replay_campaign",
        "before_paper_change",
        "before_runtime_change"
      ],
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}