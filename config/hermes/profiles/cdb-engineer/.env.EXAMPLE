# Secret names only — host path: /etc/hermes/cdb-engineer.env
# Inference (#4501): use ChatGPT/Codex OAuth via `hermes auth add openai-codex`.
# Do NOT set paid inference keys for this profile (forbidden):
#   OPENROUTER_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY, GOOGLE_API_KEY,
#   GEMINI_API_KEY, and other pay-per-token provider keys.
# Gateway/Runs API transport auth (API_SERVER_KEY / HERMES_CDB_ENGINEER_API_KEY_FILE)
# is separate host-managed auth and is not an OpenAI inference key.
CDB_GH_APP_ID=
CDB_GH_APP_INSTALLATION_ID=
CDB_GH_APP_PRIVATE_KEY_PATH=
HERMES_WINDOWS_TAILSCALE_HOST=
# Never place PEM files under D:\Dev\HermesWorkspace or /var/lib/hermes/profiles/
